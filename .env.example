# Get these from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Optional: your phone number in international format (+34XXXXXXXXX)
# If not set, will be prompted on first login
TG_PHONE=

# Session file path (default: ./tgdl.session)
TG_SESSION=tgdl

# Default download directory (can be overridden with -o flag)
# Examples:
#   TG_OUTPUT_DIR=Z:\mantt
#   TG_OUTPUT_DIR=/mnt/drive/telegram
TG_OUTPUT_DIR=downloads
